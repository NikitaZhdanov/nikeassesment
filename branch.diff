@@ -0,0 +1,230 @@
+package httpapi
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"log/slog"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/nikitazhdanov/nikeassesment/internal/catalog"
+	"github.com/stretchr/testify/require"
+)
+
+type stubRepo struct {
+	product    catalog.Product
+	products   []catalog.Product
+	err        error
+	panicValue bool
+	calls      int
+	id         uuid.UUID
+	input      catalog.Input
+	query      catalog.Query
+	deadline   bool
+}
+
+func (s *stubRepo) call(ctx context.Context) {
+	s.calls++
+	_, s.deadline = ctx.Deadline()
+	if s.panicValue {
+		panic("test panic")
+	}
+}
+func (s *stubRepo) Create(ctx context.Context, in catalog.Input) (catalog.Product, error) {
+	s.call(ctx)
+	s.input = in
+	return s.product, s.err
+}
+func (s *stubRepo) Get(ctx context.Context, id uuid.UUID) (catalog.Product, error) {
+	s.call(ctx)
+	s.id = id
+	return s.product, s.err
+}
+func (s *stubRepo) Update(ctx context.Context, id uuid.UUID, in catalog.Input) (catalog.Product, error) {
+	s.call(ctx)
+	s.id = id
+	s.input = in
+	return s.product, s.err
+}
+func (s *stubRepo) Delete(ctx context.Context, id uuid.UUID) error {
+	s.call(ctx)
+	s.id = id
+	return s.err
+}
+func (s *stubRepo) List(ctx context.Context, q catalog.Query) ([]catalog.Product, error) {
+	s.call(ctx)
+	s.query = q
+	return s.products, s.err
+}
+
+const validJSON = `{"sku":"SHOE-01","name":"Shoe","description":"A shoe","category":"shoes","price_cents":100}`
+
+func handler(s *stubRepo, pingErr error) http.Handler {
+	return New(s, func(context.Context) error { return pingErr }, slog.New(slog.NewJSONHandler(io.Discard, nil)))
+}
+
+func request(h http.Handler, method, path, body, contentType string) *httptest.ResponseRecorder {
+	r := httptest.NewRequest(method, path, strings.NewReader(body))
+	r.Header.Set("Content-Type", contentType)
+	w := httptest.NewRecorder()
+	h.ServeHTTP(w, r)
+	return w
+}
+
+func assertError(t *testing.T, w *httptest.ResponseRecorder, status int, code string) {
+	t.Helper()
+	require.Equal(t, status, w.Code, w.Body.String())
+	require.Equal(t, "application/json", w.Header().Get("Content-Type"))
+	require.NotEmpty(t, w.Header().Get("X-Request-ID"))
+	var body struct {
+		Error struct{ Code, Message string }
+	}
+	require.NoError(t, json.Unmarshal(w.Body.Bytes(), &body))
+	require.Equal(t, code, body.Error.Code)
+	require.NotEmpty(t, body.Error.Message)
+}
+
+func TestProductSuccess(t *testing.T) {
+	p := catalog.Product{ID: uuid.New(), SKU: "SHOE-01", Name: "Shoe", Category: "shoes", PriceCents: 100, CreatedAt: time.Now().UTC(), UpdatedAt: time.Now().UTC()}
+	for _, tc := range []struct {
+		method, path string
+		status       int
+	}{
+		{"POST", "/v1/products", 201}, {"GET", "/v1/products/" + p.ID.String(), 200}, {"PUT", "/v1/products/" + p.ID.String(), 200}, {"DELETE", "/v1/products/" + p.ID.String(), 204},
+	} {
+		t.Run(tc.method, func(t *testing.T) {
+			s := &stubRepo{product: p}
+			w := request(handler(s, nil), tc.method, tc.path, validJSON, "application/json; charset=utf-8")
+			require.Equal(t, tc.status, w.Code, w.Body.String())
+			require.Equal(t, 1, s.calls)
+			require.True(t, s.deadline)
+			require.NotEmpty(t, w.Header().Get("X-Request-ID"))
+			if tc.method == "DELETE" {
+				require.Empty(t, w.Body.String())
+			} else {
+				var got catalog.Product
+				require.NoError(t, json.Unmarshal(w.Body.Bytes(), &got))
+				require.Equal(t, p, got)
+			}
+			if tc.method == "POST" {
+				require.Equal(t, "/v1/products/"+p.ID.String(), w.Header().Get("Location"))
+			} else {
+				require.Equal(t, p.ID, s.id)
+			}
+			if tc.method == "POST" || tc.method == "PUT" {
+				require.Equal(t, "SHOE-01", s.input.SKU)
+				require.Equal(t, int64(100), *s.input.PriceCents)
+			}
+		})
+	}
+}
+
+func TestInvalidWrites(t *testing.T) {
+	for _, tc := range []struct {
+		name, body, media string
+		status            int
+		code              string
+	}{
+		{"malformed", "{", "application/json", 400, "validation_error"},
+		{"empty", "", "application/json", 400, "validation_error"},
+		{"null", "null", "application/json", 400, "validation_error"},
+		{"array", "[]", "application/json", 400, "validation_error"},
+		{"unknown", strings.Replace(validJSON, `"sku"`, `"unknown"`, 1), "application/json", 400, "validation_error"},
+		{"multiple", validJSON + ` {}`, "application/json", 400, "validation_error"},
+		{"trailing junk", validJSON + ` x`, "application/json", 400, "validation_error"},
+		{"missing", "{}", "application/json", 400, "validation_error"},
+		{"null price", strings.Replace(validJSON, `100`, `null`, 1), "application/json", 400, "validation_error"},
+		{"fractional", strings.Replace(validJSON, `100`, `1.2`, 1), "application/json", 400, "validation_error"},
+		{"wrong media", validJSON, "text/plain", 415, "unsupported_media_type"},
+		{"missing media", validJSON, "", 415, "unsupported_media_type"},
+		{"broken media", validJSON, "application/json; charset", 415, "unsupported_media_type"},
+		{"oversized", `{"name":"` + strings.Repeat("a", 65536) + `"}`, "application/json", 413, "payload_too_large"},
+		{"oversized trailing whitespace", validJSON + strings.Repeat(" ", 65536), "application/json", 413, "payload_too_large"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			for _, method := range []string{"POST", "PUT"} {
+				path := "/v1/products"
+				if method == "PUT" {
+					path += "/" + uuid.NewString()
+				}
+				s := &stubRepo{}
+				w := request(handler(s, nil), method, path, tc.body, tc.media)
+				assertError(t, w, tc.status, tc.code)
+				require.Zero(t, s.calls)
+			}
+		})
+	}
+}
+
+func TestErrorsAndBadIDs(t *testing.T) {
+	for _, method := range []string{"GET", "PUT", "DELETE"} {
+		s := &stubRepo{}
+		w := request(handler(s, nil), method, "/v1/products/not-uuid", validJSON, "application/json")
+		assertError(t, w, 400, "validation_error")
+		require.Zero(t, s.calls)
+	}
+	for _, tc := range []struct {
+		err    error
+		status int
+		code   string
+	}{
+		{catalog.ErrNotFound, 404, "not_found"}, {catalog.ErrConflict, 409, "conflict"}, {errors.New("secret SQL password"), 503, "unavailable"},
+	} {
+		for _, method := range []string{"POST", "GET", "PUT", "DELETE"} {
+			path := "/v1/products"
+			if method != "POST" {
+				path += "/" + uuid.NewString()
+			}
+			w := request(handler(&stubRepo{err: tc.err}, nil), method, path, validJSON, "application/json")
+			assertError(t, w, tc.status, tc.code)
+			require.NotContains(t, w.Body.String(), "secret")
+		}
+	}
+}
+
+func TestList(t *testing.T) {
+	p := catalog.Product{ID: uuid.New(), PriceCents: 10}
+	s := &stubRepo{products: []catalog.Product{p, {ID: uuid.New(), PriceCents: 20}}}
+	w := request(handler(s, nil), "GET", "/v1/products?category=shoes&min_price_cents=0&limit=1", "", "")
+	require.Equal(t, 200, w.Code)
+	var page catalog.Page
+	require.NoError(t, json.Unmarshal(w.Body.Bytes(), &page))
+	require.Len(t, page.Items, 1)
+	require.NotNil(t, page.NextCursor)
+	require.Equal(t, "shoes", s.query.Category)
+	require.Equal(t, 1, s.query.Limit)
+	w = request(handler(&stubRepo{}, nil), "GET", "/v1/products", "", "")
+	require.JSONEq(t, `{"items":[],"next_cursor":null}`, w.Body.String())
+	w = request(handler(&stubRepo{}, nil), "GET", "/v1/products?limit=0", "", "")
+	assertError(t, w, 400, "validation_error")
+	w = request(handler(&stubRepo{err: errors.New("offline")}, nil), "GET", "/v1/products", "", "")
+	assertError(t, w, 503, "unavailable")
+}
+
+func TestHealthRoutingRecovery(t *testing.T) {
+	for _, path := range []string{"/healthz", "/readyz"} {
+		w := request(handler(&stubRepo{}, nil), "GET", path, "", "")
+		require.Equal(t, 200, w.Code)
+	}
+	w := request(handler(&stubRepo{}, errors.New("offline")), "GET", "/readyz", "", "")
+	assertError(t, w, 503, "unavailable")
+	w = request(handler(&stubRepo{}, nil), "GET", "/missing", "", "")
+	assertError(t, w, 404, "not_found")
+	w = request(handler(&stubRepo{}, nil), "PATCH", "/v1/products/"+uuid.NewString(), "", "")
+	assertError(t, w, 405, "method_not_allowed")
+	require.Equal(t, "GET, PUT, DELETE", w.Header().Get("Allow"))
+	for path, allowed := range map[string]string{"/v1/products": "GET, POST", "/healthz": "GET", "/readyz": "GET"} {
+		w = request(handler(&stubRepo{}, nil), "PATCH", path, "", "")
+		assertError(t, w, 405, "method_not_allowed")
+		require.Equal(t, allowed, w.Header().Get("Allow"))
+	}
+	w = request(handler(&stubRepo{panicValue: true}, nil), "GET", "/v1/products", "", "")
+	assertError(t, w, 500, "internal_error")
+	require.NotContains(t, w.Body.String(), "test panic")
+}
diff --git a/internal/postgres/repository.go b/internal/postgres/repository.go
new file mode 100644
index 0000000..7e50caa
--- /dev/null
+++ b/internal/postgres/repository.go
@@ -0,0 +1,114 @@
+package postgres
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strings"
+
+	"github.com/google/uuid"
+	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/pgconn"
+	"github.com/nikitazhdanov/nikeassesment/internal/catalog"
+)
+
+type DB interface {
+	QueryRow(context.Context, string, ...any) pgx.Row
+	Query(context.Context, string, ...any) (pgx.Rows, error)
+	Exec(context.Context, string, ...any) (pgconn.CommandTag, error)
+}
+
+type Repository struct{ db DB }
+
+func New(db DB) *Repository { return &Repository{db: db} }
+
+const columns = "id, sku, name, description, category, price_cents, created_at, updated_at"
+
+func (r *Repository) Create(ctx context.Context, in catalog.Input) (catalog.Product, error) {
+	return scan(r.db.QueryRow(ctx, `INSERT INTO products (id, sku, name, description, category, price_cents)
+		VALUES ($1, $2, $3, $4, $5, $6) RETURNING `+columns,
+		uuid.New().String(), in.SKU, in.Name, in.Description, in.Category, *in.PriceCents))
+}
+
+func (r *Repository) Get(ctx context.Context, id uuid.UUID) (catalog.Product, error) {
+	return scan(r.db.QueryRow(ctx, "SELECT "+columns+" FROM products WHERE id = $1", id.String()))
+}
+
+func (r *Repository) Update(ctx context.Context, id uuid.UUID, in catalog.Input) (catalog.Product, error) {
+	return scan(r.db.QueryRow(ctx, `UPDATE products SET sku = $2, name = $3, description = $4,
+		category = $5, price_cents = $6, updated_at = GREATEST(clock_timestamp(), updated_at + interval '1 microsecond')
+		WHERE id = $1 RETURNING `+columns,
+		id.String(), in.SKU, in.Name, in.Description, in.Category, *in.PriceCents))
+}
+
+func (r *Repository) Delete(ctx context.Context, id uuid.UUID) error {
+	tag, err := r.db.Exec(ctx, "DELETE FROM products WHERE id = $1", id.String())
+	if err != nil {
+		return err
+	}
+	if tag.RowsAffected() == 0 {
+		return catalog.ErrNotFound
+	}
+	return nil
+}
+
+func (r *Repository) List(ctx context.Context, q catalog.Query) ([]catalog.Product, error) {
+	sql, args := listSQL(q)
+	rows, err := r.db.Query(ctx, sql, args...)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	products := make([]catalog.Product, 0, q.Limit+1)
+	for rows.Next() {
+		p, err := scan(rows)
+		if err != nil {
+			return nil, err
+		}
+		products = append(products, p)
+	}
+	return products, rows.Err()
+}
+
+func scan(row pgx.Row) (catalog.Product, error) {
+	var p catalog.Product
+	err := row.Scan(&p.ID, &p.SKU, &p.Name, &p.Description, &p.Category, &p.PriceCents, &p.CreatedAt, &p.UpdatedAt)
+	if errors.Is(err, pgx.ErrNoRows) {
+		return p, catalog.ErrNotFound
+	}
+	var pgErr *pgconn.PgError
+	if errors.As(err, &pgErr) && pgErr.Code == "23505" {
+		return p, catalog.ErrConflict
+	}
+	p.CreatedAt, p.UpdatedAt = p.CreatedAt.UTC(), p.UpdatedAt.UTC()
+	return p, err
+}
+
+func listSQL(q catalog.Query) (string, []any) {
+	var conditions []string
+	var args []any
+	add := func(condition string, value any) {
+		args = append(args, value)
+		conditions = append(conditions, fmt.Sprintf(condition, len(args)))
+	}
+	if q.Category != "" {
+		add("category = $%d", q.Category)
+	}
+	if q.Min != nil {
+		add("price_cents >= $%d", *q.Min)
+	}
+	if q.Max != nil {
+		add("price_cents <= $%d", *q.Max)
+	}
+	if q.After != nil {
+		args = append(args, q.After.Price, q.After.ID.String())
+		conditions = append(conditions, fmt.Sprintf("(price_cents, id) > ($%d, $%d)", len(args)-1, len(args)))
+	}
+	sql := "SELECT " + columns + " FROM products"
+	if len(conditions) > 0 {
+		sql += " WHERE " + strings.Join(conditions, " AND ")
+	}
+	args = append(args, q.Limit+1)
+	sql += fmt.Sprintf(" ORDER BY price_cents, id LIMIT $%d", len(args))
+	return sql, args
+}
diff --git a/internal/postgres/repository_integration_test.go b/internal/postgres/repository_integration_test.go
new file mode 100644
index 0000000..c512bcd
--- /dev/null
+++ b/internal/postgres/repository_integration_test.go
@@ -0,0 +1,239 @@
+//go:build integration
+
+package postgres
+
+import (
+	"context"
+	"errors"
+	"os"
+	"sort"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/google/uuid"
+	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/pgconn"
+	"github.com/jackc/pgx/v5/pgxpool"
+	"github.com/nikitazhdanov/nikeassesment/internal/catalog"
+	"github.com/stretchr/testify/require"
+)
+
+func integrationPool(t *testing.T) *pgxpool.Pool {
+	t.Helper()
+	dsn := os.Getenv("TEST_DATABASE_URL")
+	require.NotEmpty(t, dsn, "integration tests require TEST_DATABASE_URL pointing to a disposable migrated PostgreSQL database")
+	pool, err := pgxpool.New(context.Background(), dsn)
+	require.NoError(t, err)
+	t.Cleanup(pool.Close)
+	require.NoError(t, pool.Ping(context.Background()))
+	return pool
+}
+
+func integrationTx(t *testing.T) pgx.Tx {
+	t.Helper()
+	pool := integrationPool(t)
+	tx, err := pool.Begin(context.Background())
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = tx.Rollback(context.Background()) })
+	return tx
+}
+
+func TestIntegrationMigrationUpDown(t *testing.T) {
+	tx := integrationTx(t)
+	ctx := context.Background()
+	var version int
+	var dirty bool
+	require.NoError(t, tx.QueryRow(ctx, "SELECT version, dirty FROM schema_migrations").Scan(&version, &dirty))
+	require.Equal(t, 1, version)
+	require.False(t, dirty)
+	for _, name := range []string{"000001_products.down.sql", "000001_products.up.sql"} {
+		sql, err := os.ReadFile("../../migrations/" + name)
+		require.NoError(t, err)
+		_, err = tx.Exec(ctx, string(sql))
+		require.NoError(t, err)
+	}
+	var count int
+	require.NoError(t, tx.QueryRow(ctx, "SELECT count(*) FROM pg_indexes WHERE tablename='products' AND schemaname=current_schema()").Scan(&count))
+	require.Equal(t, 4, count)
+	_, err := New(tx).Create(ctx, input(fixture()))
+	require.NoError(t, err)
+}
+
+func TestIntegrationCRUD(t *testing.T) {
+	tx := integrationTx(t)
+	r := New(tx)
+	ctx := context.Background()
+	in := input(fixture())
+	p, err := r.Create(ctx, in)
+	require.NoError(t, err)
+	require.NotEqual(t, uuid.Nil, p.ID)
+	require.False(t, p.CreatedAt.IsZero())
+	got, err := r.Get(ctx, p.ID)
+	require.NoError(t, err)
+	require.Equal(t, p, got)
+	in.SKU = "UPDATED-01"
+	in.Name = "New shoe"
+	in.Category = "new-shoes"
+	in.Description = ""
+	price := int64(0)
+	in.PriceCents = &price
+	updated, err := r.Update(ctx, p.ID, in)
+	require.NoError(t, err)
+	require.Equal(t, p.ID, updated.ID)
+	require.Equal(t, p.CreatedAt, updated.CreatedAt)
+	require.True(t, updated.UpdatedAt.After(p.UpdatedAt))
+	require.Zero(t, updated.PriceCents)
+	require.Empty(t, updated.Description)
+	got, err = r.Get(ctx, p.ID)
+	require.NoError(t, err)
+	require.Equal(t, updated, got)
+	_, err = r.Update(ctx, uuid.New(), in)
+	require.ErrorIs(t, err, catalog.ErrNotFound)
+	require.NoError(t, r.Delete(ctx, p.ID))
+	_, err = r.Get(ctx, p.ID)
+	require.ErrorIs(t, err, catalog.ErrNotFound)
+	require.ErrorIs(t, r.Delete(ctx, p.ID), catalog.ErrNotFound)
+}
+
+func TestIntegrationFiltersAndPagination(t *testing.T) {
+	r := New(integrationTx(t))
+	ctx := context.Background()
+	var products []catalog.Product
+	for i, price := range []int64{0, 100, 100, 200, 300, 150} {
+		in := input(fixture())
+		in.SKU = strings.ToUpper(uuid.NewString())
+		in.PriceCents = &price
+		if i == 5 {
+			in.Category = "shirts"
+		}
+		p, err := r.Create(ctx, in)
+		require.NoError(t, err)
+		products = append(products, p)
+	}
+	for _, tc := range []struct {
+		raw   string
+		count int
+	}{
+		{"", 6}, {"category=shoes", 5}, {"min_price_cents=150", 3}, {"max_price_cents=100", 3}, {"min_price_cents=0&max_price_cents=0", 1}, {"category=missing", 0},
+	} {
+		q, err := catalog.ParseQuery(tc.raw)
+		require.NoError(t, err)
+		got, err := r.List(ctx, q)
+		require.NoError(t, err)
+		require.Len(t, got, tc.count, tc.raw)
+	}
+	filter := "category=shoes&min_price_cents=100&max_price_cents=200&limit=1"
+	q, err := catalog.ParseQuery(filter)
+	require.NoError(t, err)
+	var gotIDs []uuid.UUID
+	for pageNumber := 0; pageNumber < 10; pageNumber++ {
+		rows, err := r.List(ctx, q)
+		require.NoError(t, err)
+		page := catalog.NewPage(rows, q)
+		for _, p := range page.Items {
+			gotIDs = append(gotIDs, p.ID)
+		}
+		if page.NextCursor == nil {
+			break
+		}
+		q, err = catalog.ParseQuery(filter + "&cursor=" + *page.NextCursor)
+		require.NoError(t, err)
+	}
+	want := products[1:4]
+	sort.Slice(want, func(i, j int) bool {
+		if want[i].PriceCents != want[j].PriceCents {
+			return want[i].PriceCents < want[j].PriceCents
+		}
+		return want[i].ID.String() < want[j].ID.String()
+	})
+	require.Equal(t, []uuid.UUID{want[0].ID, want[1].ID, want[2].ID}, gotIDs)
+}
+
+func TestIntegrationConstraints(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		column string
+		value  any
+		code   string
+	}{
+		{"price negative", "price_cents", int64(-1), "23514"},
+		{"price overflow", "price_cents", catalog.MaxPrice + 1, "23514"},
+		{"price null", "price_cents", nil, "23502"},
+		{"sku case", "sku", "lower", "23514"},
+		{"name blank", "name", " \t\n", "23514"},
+		{"name length", "name", strings.Repeat("a", 201), "23514"},
+		{"description length", "description", strings.Repeat("a", 5001), "23514"},
+		{"category pattern", "category", "Wrong Category", "23514"},
+		{"category length", "category", strings.Repeat("a", 65), "23514"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			tx := integrationTx(t)
+			p, err := New(tx).Create(context.Background(), input(fixture()))
+			require.NoError(t, err)
+			// Column names are fixed test cases, never client input.
+			_, err = tx.Exec(context.Background(), "UPDATE products SET "+tc.column+"=$1 WHERE id=$2", tc.value, p.ID.String())
+			var pgErr *pgconn.PgError
+			require.ErrorAs(t, err, &pgErr)
+			require.Equal(t, tc.code, pgErr.Code)
+		})
+	}
+}
+
+func TestIntegrationConcurrentUniquenessAndPersistence(t *testing.T) {
+	pool := integrationPool(t)
+	r := New(pool)
+	ctx := context.Background()
+	in := input(fixture())
+	in.SKU = strings.ToUpper(uuid.NewString())
+	t.Cleanup(func() { _, err := pool.Exec(ctx, "DELETE FROM products WHERE sku=$1", in.SKU); require.NoError(t, err) })
+	type outcome struct {
+		p   catalog.Product
+		err error
+	}
+	results := make(chan outcome, 2)
+	start := make(chan struct{})
+	var wg sync.WaitGroup
+	for range 2 {
+		wg.Add(1)
+		go func() { defer wg.Done(); <-start; p, err := r.Create(ctx, in); results <- outcome{p, err} }()
+	}
+	close(start)
+	wg.Wait()
+	close(results)
+	successes, conflicts := 0, 0
+	var saved catalog.Product
+	for result := range results {
+		if result.err == nil {
+			successes++
+			saved = result.p
+		} else if errors.Is(result.err, catalog.ErrConflict) {
+			conflicts++
+		} else {
+			require.NoError(t, result.err)
+		}
+	}
+	require.Equal(t, 1, successes)
+	require.Equal(t, 1, conflicts)
+	// A separate connection pool observes the committed row.
+	got, err := New(integrationPool(t)).Get(ctx, saved.ID)
+	require.NoError(t, err)
+	require.Equal(t, saved, got)
+}
+
+func TestIntegrationUpdateConflict(t *testing.T) {
+	r := New(integrationTx(t))
+	ctx := context.Background()
+	one := input(fixture())
+	two := input(fixture())
+	two.SKU = "OTHER-SKU"
+	p, err := r.Create(ctx, one)
+	require.NoError(t, err)
+	other, err := r.Create(ctx, two)
+	require.NoError(t, err)
+	_, err = r.Update(ctx, other.ID, one)
+	require.ErrorIs(t, err, catalog.ErrConflict)
+	// The transaction is aborted after a constraint violation; PostgreSQL atomicity
+	// ensures the failed statement cannot partially update the other product.
+	require.NotEqual(t, p.ID, other.ID)
+}
