diff --git a/internal/app/app.go b/internal/app/app.go
new file mode 100644
index 0000000..9208ac7
--- /dev/null
+++ b/internal/app/app.go
@@ -0,0 +1,95 @@
+package app
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"log/slog"
+	"net/http"
+	"strconv"
+	"time"
+
+	"github.com/jackc/pgx/v5/pgxpool"
+	"github.com/nikitazhdanov/nikeassesment/internal/httpapi"
+	"github.com/nikitazhdanov/nikeassesment/internal/postgres"
+)
+
+type Config struct {
+	DatabaseURL string
+	HTTPAddr    string
+	MaxConns    int32
+}
+
+func LoadConfig(getenv func(string) string) (Config, error) {
+	c := Config{DatabaseURL: getenv("DATABASE_URL"), HTTPAddr: getenv("HTTP_ADDR"), MaxConns: 10}
+	if c.DatabaseURL == "" {
+		return c, errors.New("DATABASE_URL is required")
+	}
+	if c.HTTPAddr == "" {
+		c.HTTPAddr = ":8080"
+	}
+	if value := getenv("DB_MAX_CONNS"); value != "" {
+		n, err := strconv.ParseInt(value, 10, 32)
+		if err != nil || n < 1 || n > 100 {
+			return c, errors.New("DB_MAX_CONNS must be between 1 and 100")
+		}
+		c.MaxConns = int32(n)
+	}
+	return c, nil
+}
+
+func Run(ctx context.Context, c Config, log *slog.Logger) error {
+	poolConfig, err := pgxpool.ParseConfig(c.DatabaseURL)
+	if err != nil {
+		return errors.New("invalid DATABASE_URL")
+	}
+	poolConfig.MaxConns = c.MaxConns
+	poolConfig.ConnConfig.ConnectTimeout = 5 * time.Second
+	pool, err := pgxpool.NewWithConfig(ctx, poolConfig)
+	if err != nil {
+		return errors.New("cannot initialize database pool")
+	}
+	defer pool.Close()
+	startup, cancel := context.WithTimeout(ctx, 10*time.Second)
+	err = pool.Ping(startup)
+	cancel()
+	if err != nil {
+		return errors.New("database unavailable at startup")
+	}
+	server := &http.Server{
+		Addr: c.HTTPAddr, Handler: httpapi.New(postgres.New(pool), pool.Ping, log),
+		ReadHeaderTimeout: 5 * time.Second, ReadTimeout: 10 * time.Second,
+		WriteTimeout: 10 * time.Second, IdleTimeout: 60 * time.Second, MaxHeaderBytes: 16 << 10,
+	}
+	log.Info("starting catalog", "address", c.HTTPAddr)
+	return Serve(ctx, server)
+}
+
+type Server interface {
+	ListenAndServe() error
+	Shutdown(context.Context) error
+	Close() error
+}
+
+// Serve owns server lifetime; cancellation drains in-flight requests before close.
+func Serve(ctx context.Context, server Server) error {
+	result := make(chan error, 1)
+	go func() { result <- server.ListenAndServe() }()
+	select {
+	case err := <-result:
+		if errors.Is(err, http.ErrServerClosed) {
+			return nil
+		}
+		return fmt.Errorf("serve: %w", err)
+	case <-ctx.Done():
+		shutdown, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+		defer cancel()
+		if err := server.Shutdown(shutdown); err != nil {
+			_ = server.Close()
+			<-result
+			return fmt.Errorf("shutdown: %w", err)
+		}
+		<-result
+		return nil
+	}
+}
diff --git a/internal/app/app_test.go b/internal/app/app_test.go
new file mode 100644
index 0000000..de61b76
--- /dev/null
+++ b/internal/app/app_test.go
@@ -0,0 +1,110 @@
+package app
+
+import (
+	"context"
+	"errors"
+	"io"
+	"log/slog"
+	"net/http"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestLoadConfig(t *testing.T) {
+	for _, tc := range []struct {
+		name  string
+		env   map[string]string
+		valid bool
+	}{
+		{"required", map[string]string{}, false},
+		{"defaults", map[string]string{"DATABASE_URL": "postgres://localhost/catalog"}, true},
+		{"custom", map[string]string{"DATABASE_URL": "postgres://localhost/catalog", "HTTP_ADDR": ":9000", "DB_MAX_CONNS": "20"}, true},
+		{"zero", map[string]string{"DATABASE_URL": "x", "DB_MAX_CONNS": "0"}, false},
+		{"large", map[string]string{"DATABASE_URL": "x", "DB_MAX_CONNS": "101"}, false},
+		{"invalid", map[string]string{"DATABASE_URL": "x", "DB_MAX_CONNS": "abc"}, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			c, err := LoadConfig(func(key string) string { return tc.env[key] })
+			if !tc.valid {
+				require.Error(t, err)
+				return
+			}
+			require.NoError(t, err)
+			if tc.name == "defaults" {
+				require.Equal(t, ":8080", c.HTTPAddr)
+				require.Equal(t, int32(10), c.MaxConns)
+			} else {
+				require.Equal(t, ":9000", c.HTTPAddr)
+				require.Equal(t, int32(20), c.MaxConns)
+			}
+		})
+	}
+}
+
+func TestRunStartupFailures(t *testing.T) {
+	log := slog.New(slog.NewTextHandler(io.Discard, nil))
+	err := Run(context.Background(), Config{DatabaseURL: "://invalid", MaxConns: 1}, log)
+	require.EqualError(t, err, "invalid DATABASE_URL")
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	err = Run(ctx, Config{DatabaseURL: "postgres://localhost:1/catalog?sslmode=disable", MaxConns: 1}, log)
+	require.EqualError(t, err, "database unavailable at startup")
+}
+
+type fakeServer struct {
+	started     chan struct{}
+	stopped     chan struct{}
+	listenErr   error
+	shutdownErr error
+	closed      bool
+	deadline    bool
+}
+
+func (s *fakeServer) ListenAndServe() error {
+	close(s.started)
+	if s.listenErr != nil {
+		return s.listenErr
+	}
+	<-s.stopped
+	return http.ErrServerClosed
+}
+func (s *fakeServer) Shutdown(ctx context.Context) error {
+	_, s.deadline = ctx.Deadline()
+	if s.shutdownErr != nil {
+		return s.shutdownErr
+	}
+	close(s.stopped)
+	return nil
+}
+func (s *fakeServer) Close() error { s.closed = true; close(s.stopped); return nil }
+
+func TestServe(t *testing.T) {
+	for _, listenErr := range []error{http.ErrServerClosed, errors.New("bind failed")} {
+		s := &fakeServer{started: make(chan struct{}), listenErr: listenErr}
+		err := Serve(context.Background(), s)
+		if errors.Is(listenErr, http.ErrServerClosed) {
+			require.NoError(t, err)
+		} else {
+			require.ErrorIs(t, err, listenErr)
+		}
+	}
+	for _, shutdownErr := range []error{nil, errors.New("drain timeout")} {
+		s := &fakeServer{started: make(chan struct{}), stopped: make(chan struct{}), shutdownErr: shutdownErr}
+		ctx, cancel := context.WithCancel(context.Background())
+		defer cancel()
+		result := make(chan error, 1)
+		go func() { result <- Serve(ctx, s) }()
+		<-s.started
+		cancel()
+		err := <-result
+		require.True(t, s.deadline)
+		if shutdownErr == nil {
+			require.NoError(t, err)
+			require.False(t, s.closed)
+		} else {
+			require.ErrorIs(t, err, shutdownErr)
+			require.True(t, s.closed)
+		}
+	}
+}
diff --git a/internal/catalog/product.go b/internal/catalog/product.go
new file mode 100644
index 0000000..d01272c
--- /dev/null
+++ b/internal/catalog/product.go
@@ -0,0 +1,67 @@
+package catalog
+
+import (
+	"errors"
+	"regexp"
+	"strings"
+	"time"
+
+	"github.com/go-playground/validator/v10"
+	"github.com/google/uuid"
+)
+
+const MaxPrice int64 = 1_000_000_000_000
+
+var (
+	ErrNotFound     = errors.New("product not found")
+	ErrConflict     = errors.New("SKU already exists")
+	validate        = validator.New(validator.WithRequiredStructEnabled())
+	skuPattern      = regexp.MustCompile(`^[A-Z0-9][A-Z0-9_-]{0,63}$`)
+	categoryPattern = regexp.MustCompile(`^[a-z0-9]+(-[a-z0-9]+)*$`)
+)
+
+type Product struct {
+	ID          uuid.UUID `json:"id"`
+	SKU         string    `json:"sku"`
+	Name        string    `json:"name"`
+	Description string    `json:"description"`
+	Category    string    `json:"category"`
+	PriceCents  int64     `json:"price_cents"`
+	CreatedAt   time.Time `json:"created_at"`
+	UpdatedAt   time.Time `json:"updated_at"`
+}
+
+// Input is a full replacement. A pointer distinguishes a free product from an
+// omitted or null price. Descriptions intentionally default to the empty string.
+type Input struct {
+	SKU         string `json:"sku" validate:"required,max=64"`
+	Name        string `json:"name" validate:"required,max=200"`
+	Description string `json:"description" validate:"max=5000"`
+	Category    string `json:"category" validate:"required,max=64"`
+	PriceCents  *int64 `json:"price_cents" validate:"required,gte=0,lte=1000000000000"`
+}
+
+func (in Input) Validate() error {
+	if err := validate.Struct(in); err != nil {
+		return errors.New("required fields or field limits are invalid")
+	}
+	if !skuPattern.MatchString(in.SKU) {
+		return errors.New("sku must contain uppercase letters, digits, underscores or hyphens")
+	}
+	if strings.TrimSpace(in.Name) == "" {
+		return errors.New("name must not be blank")
+	}
+	return ValidateCategory(in.Category)
+}
+
+func ValidateCategory(category string) error {
+	if len(category) > 64 || !categoryPattern.MatchString(category) {
+		return errors.New("category must be a lowercase slug of 1 to 64 characters")
+	}
+	return nil
+}
+
+type Page struct {
+	Items      []Product `json:"items"`
+	NextCursor *string   `json:"next_cursor"`
+}
diff --git a/internal/catalog/product_test.go b/internal/catalog/product_test.go
new file mode 100644
index 0000000..b327c56
--- /dev/null
+++ b/internal/catalog/product_test.go
@@ -0,0 +1,58 @@
+package catalog
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func ptr(n int64) *int64 { return &n }
+
+func validInput() Input {
+	return Input{SKU: "SHOE-01_A", Name: "Running shoe", Category: "running-shoes", PriceCents: ptr(100)}
+}
+
+func TestInputValidation(t *testing.T) {
+	tests := []struct {
+		name   string
+		change func(*Input)
+		valid  bool
+	}{
+		{"valid", func(*Input) {}, true},
+		{"free", func(in *Input) { in.PriceCents = ptr(0) }, true},
+		{"upper boundaries", func(in *Input) {
+			in.PriceCents = ptr(MaxPrice)
+			in.Name = strings.Repeat("é", 200)
+			in.Description = strings.Repeat("é", 5000)
+			in.SKU = strings.Repeat("A", 64)
+			in.Category = strings.Repeat("a", 64)
+		}, true},
+		{"missing price", func(in *Input) { in.PriceCents = nil }, false},
+		{"negative price", func(in *Input) { in.PriceCents = ptr(-1) }, false},
+		{"price too large", func(in *Input) { in.PriceCents = ptr(MaxPrice + 1) }, false},
+		{"missing SKU", func(in *Input) { in.SKU = "" }, false},
+		{"lowercase SKU", func(in *Input) { in.SKU = "shoe" }, false},
+		{"SKU punctuation", func(in *Input) { in.SKU = "-SHOE" }, false},
+		{"SKU too long", func(in *Input) { in.SKU = strings.Repeat("A", 65) }, false},
+		{"name missing", func(in *Input) { in.Name = "" }, false},
+		{"name blank", func(in *Input) { in.Name = " \t\n\u2003" }, false},
+		{"name too long", func(in *Input) { in.Name = strings.Repeat("é", 201) }, false},
+		{"description too long", func(in *Input) { in.Description = strings.Repeat("é", 5001) }, false},
+		{"category missing", func(in *Input) { in.Category = "" }, false},
+		{"category uppercase", func(in *Input) { in.Category = "Shoes" }, false},
+		{"category double hyphen", func(in *Input) { in.Category = "running--shoes" }, false},
+		{"category too long", func(in *Input) { in.Category = strings.Repeat("a", 65) }, false},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			in := validInput()
+			tc.change(&in)
+			if tc.valid {
+				require.NoError(t, in.Validate())
+			} else {
+				require.Error(t, in.Validate())
+			}
+		})
+	}
+}
diff --git a/internal/catalog/query.go b/internal/catalog/query.go
new file mode 100644
index 0000000..2dc3a8e
--- /dev/null
+++ b/internal/catalog/query.go
@@ -0,0 +1,125 @@
+package catalog
+
+import (
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"net/url"
+	"strconv"
+
+	"github.com/google/uuid"
+)
+
+type Filters struct {
+	Category string `json:"category"`
+	Min      *int64 `json:"min"`
+	Max      *int64 `json:"max"`
+}
+
+type Position struct {
+	Price int64     `json:"price"`
+	ID    uuid.UUID `json:"id"`
+}
+
+type Query struct {
+	Filters
+	Limit int
+	After *Position
+}
+
+type cursor struct {
+	Version int `json:"v"`
+	Position
+	Fingerprint string `json:"filters"`
+}
+
+func ParseQuery(raw string) (Query, error) {
+	q := Query{Limit: 20}
+	values, err := url.ParseQuery(raw)
+	if err != nil {
+		return q, errors.New("invalid query encoding")
+	}
+	for key, values := range values {
+		if len(values) != 1 || values[0] == "" {
+			return q, errors.New("query parameters must have one nonempty value")
+		}
+		switch key {
+		case "category", "min_price_cents", "max_price_cents", "limit", "cursor":
+		default:
+			return q, errors.New("unknown query parameter")
+		}
+	}
+	q.Category = values.Get("category")
+	if q.Category != "" {
+		if err := ValidateCategory(q.Category); err != nil {
+			return q, err
+		}
+	}
+	for key, dest := range map[string]**int64{"min_price_cents": &q.Min, "max_price_cents": &q.Max} {
+		if value := values.Get(key); value != "" {
+			n, err := strconv.ParseInt(value, 10, 64)
+			if err != nil || n < 0 || n > MaxPrice {
+				return q, errors.New("price bounds must be integers within the supported range")
+			}
+			*dest = &n
+		}
+	}
+	if q.Min != nil && q.Max != nil && *q.Min > *q.Max {
+		return q, errors.New("minimum price exceeds maximum price")
+	}
+	if value := values.Get("limit"); value != "" {
+		q.Limit, err = strconv.Atoi(value)
+		if err != nil || q.Limit < 1 || q.Limit > 100 {
+			return q, errors.New("limit must be an integer from 1 to 100")
+		}
+	}
+	if value := values.Get("cursor"); value != "" {
+		q.After, err = decodeCursor(value, q.Filters)
+	}
+	return q, err
+}
+
+func fingerprint(f Filters) string {
+	data, _ := json.Marshal(f) // Filters contains only JSON-safe scalar types.
+	sum := sha256.Sum256(data)
+	return hex.EncodeToString(sum[:])
+}
+
+func EncodeCursor(p Product, f Filters) string {
+	data, _ := json.Marshal(cursor{Version: 1, Position: Position{Price: p.PriceCents, ID: p.ID}, Fingerprint: fingerprint(f)})
+	return base64.RawURLEncoding.EncodeToString(data)
+}
+
+func decodeCursor(value string, f Filters) (*Position, error) {
+	invalid := errors.New("invalid cursor or cursor filters do not match")
+	if len(value) > 1024 {
+		return nil, invalid
+	}
+	data, err := base64.RawURLEncoding.DecodeString(value)
+	if err != nil {
+		return nil, invalid
+	}
+	var c cursor
+	if err := json.Unmarshal(data, &c); err != nil {
+		return nil, invalid
+	}
+	if c.Version != 1 || c.ID == uuid.Nil || c.Price < 0 || c.Price > MaxPrice || c.Fingerprint != fingerprint(f) {
+		return nil, invalid
+	}
+	return &c.Position, nil
+}
+
+func NewPage(products []Product, q Query) Page {
+	if products == nil {
+		products = []Product{}
+	}
+	page := Page{Items: products}
+	if len(products) > q.Limit {
+		page.Items = products[:q.Limit]
+		next := EncodeCursor(page.Items[len(page.Items)-1], q.Filters)
+		page.NextCursor = &next
+	}
+	return page
+}
diff --git a/internal/catalog/query_test.go b/internal/catalog/query_test.go
new file mode 100644
index 0000000..fda6178
--- /dev/null
+++ b/internal/catalog/query_test.go
@@ -0,0 +1,79 @@
+package catalog
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"net/url"
+	"strings"
+	"testing"
+
+	"github.com/google/uuid"
+	"github.com/stretchr/testify/require"
+)
+
+func TestParseQuery(t *testing.T) {
+	q, err := ParseQuery("")
+	require.NoError(t, err)
+	require.Equal(t, 20, q.Limit)
+	require.Nil(t, q.Min)
+	q, err = ParseQuery("category=shoes&min_price_cents=0&max_price_cents=1000000000000&limit=100")
+	require.NoError(t, err)
+	require.Equal(t, "shoes", q.Category)
+	require.Equal(t, int64(0), *q.Min)
+	require.Equal(t, MaxPrice, *q.Max)
+	require.Equal(t, 100, q.Limit)
+	for _, raw := range []string{"%zz", "a=b;c", "unknown=1", "limit=1&limit=2", "limit=", "category=Bad", "min_price_cents=-1", "max_price_cents=1000000000001", "min_price_cents=1.5", "max_price_cents=9223372036854775808", "min_price_cents=2&max_price_cents=1", "limit=0", "limit=101", "limit=no", "cursor=%%%"} {
+		t.Run(raw, func(t *testing.T) { _, err := ParseQuery(raw); require.Error(t, err) })
+	}
+}
+
+func TestCursorRoundTripAndFilterBinding(t *testing.T) {
+	f := Filters{Category: "shoes", Min: ptr(0), Max: ptr(200)}
+	p := Product{ID: uuid.New(), PriceCents: 100}
+	token := EncodeCursor(p, f)
+	q, err := ParseQuery("category=shoes&min_price_cents=0&max_price_cents=200&limit=1&cursor=" + url.QueryEscape(token))
+	require.NoError(t, err)
+	require.Equal(t, &Position{Price: 100, ID: p.ID}, q.After)
+	for _, changed := range []Filters{{}, {Category: "shirts", Min: f.Min, Max: f.Max}, {Category: f.Category, Max: f.Max}, {Category: f.Category, Min: f.Min, Max: ptr(201)}} {
+		_, err := decodeCursor(token, changed)
+		require.Error(t, err)
+	}
+}
+
+func TestInvalidCursors(t *testing.T) {
+	f := Filters{}
+	encode := func(c cursor) string {
+		b, err := json.Marshal(c)
+		require.NoError(t, err)
+		return base64.RawURLEncoding.EncodeToString(b)
+	}
+	good := cursor{Version: 1, Position: Position{ID: uuid.New(), Price: 1}, Fingerprint: fingerprint(f)}
+	tokens := []string{strings.Repeat("a", 1025), "%%%", base64.RawURLEncoding.EncodeToString([]byte("{")), base64.RawURLEncoding.EncodeToString([]byte(`{"id":"bad"}`))}
+	for _, change := range []func(*cursor){func(c *cursor) { c.Version = 2 }, func(c *cursor) { c.ID = uuid.Nil }, func(c *cursor) { c.Price = -1 }, func(c *cursor) { c.Price = MaxPrice + 1 }, func(c *cursor) { c.Fingerprint = "bad" }} {
+		c := good
+		change(&c)
+		tokens = append(tokens, encode(c))
+	}
+	for _, token := range tokens {
+		_, err := decodeCursor(token, f)
+		require.Error(t, err)
+	}
+}
+
+func TestNewPage(t *testing.T) {
+	q := Query{Limit: 2}
+	page := NewPage(nil, q)
+	require.NotNil(t, page.Items)
+	require.Empty(t, page.Items)
+	require.Nil(t, page.NextCursor)
+	products := []Product{{ID: uuid.New(), PriceCents: 10}, {ID: uuid.New(), PriceCents: 10}, {ID: uuid.New(), PriceCents: 11}}
+	page = NewPage(products[:2], q)
+	require.Len(t, page.Items, 2)
+	require.Nil(t, page.NextCursor)
+	page = NewPage(products, q)
+	require.Len(t, page.Items, 2)
+	require.NotNil(t, page.NextCursor)
+	position, err := decodeCursor(*page.NextCursor, q.Filters)
+	require.NoError(t, err)
+	require.Equal(t, products[1].ID, position.ID)
+}
diff --git a/internal/httpapi/api.go b/internal/httpapi/api.go
new file mode 100644
index 0000000..1b5b5fd
--- /dev/null
+++ b/internal/httpapi/api.go
@@ -0,0 +1,222 @@
+package httpapi
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"log/slog"
+	"mime"
+	"net/http"
+	"strings"
+	"time"
+
+	"github.com/go-chi/chi/v5"
+	"github.com/go-chi/chi/v5/middleware"
+	"github.com/google/uuid"
+	"github.com/nikitazhdanov/nikeassesment/internal/catalog"
+)
+
+type Repository interface {
+	Create(context.Context, catalog.Input) (catalog.Product, error)
+	Get(context.Context, uuid.UUID) (catalog.Product, error)
+	Update(context.Context, uuid.UUID, catalog.Input) (catalog.Product, error)
+	Delete(context.Context, uuid.UUID) error
+	List(context.Context, catalog.Query) ([]catalog.Product, error)
+}
+
+type API struct {
+	repo Repository
+	ping func(context.Context) error
+	log  *slog.Logger
+}
+
+func New(repo Repository, ping func(context.Context) error, log *slog.Logger) http.Handler {
+	a := &API{repo: repo, ping: ping, log: log}
+	r := chi.NewRouter()
+	r.Use(middleware.RequestID, a.observe)
+	r.Get("/healthz", func(w http.ResponseWriter, r *http.Request) {
+		respond(w, http.StatusOK, map[string]string{"status": "ok"})
+	})
+	r.Get("/readyz", a.ready)
+	r.Post("/v1/products", a.create)
+	r.Get("/v1/products", a.list)
+	r.Get("/v1/products/{id}", a.get)
+	r.Put("/v1/products/{id}", a.update)
+	r.Delete("/v1/products/{id}", a.delete)
+	r.NotFound(func(w http.ResponseWriter, r *http.Request) { fail(w, 404, "not_found", "route not found") })
+	r.MethodNotAllowed(func(w http.ResponseWriter, req *http.Request) {
+		var allowed []string
+		for _, method := range []string{http.MethodGet, http.MethodPost, http.MethodPut, http.MethodDelete} {
+			if r.Match(chi.NewRouteContext(), method, req.URL.Path) {
+				allowed = append(allowed, method)
+			}
+		}
+		w.Header().Set("Allow", strings.Join(allowed, ", "))
+		fail(w, 405, "method_not_allowed", "method not allowed")
+	})
+	return r
+}
+
+func (a *API) observe(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		start := time.Now()
+		w.Header().Set("X-Request-ID", middleware.GetReqID(r.Context()))
+		ww := middleware.NewWrapResponseWriter(w, r.ProtoMajor)
+		ctx, cancel := context.WithTimeout(r.Context(), 5*time.Second)
+		defer cancel()
+		defer func() {
+			if recovered := recover(); recovered != nil {
+				a.log.Error("request panic", "request_id", middleware.GetReqID(r.Context()), "panic", recovered)
+				fail(ww, 500, "internal_error", "internal server error")
+			}
+			a.log.Info("request", "request_id", middleware.GetReqID(r.Context()), "method", r.Method,
+				"path", r.URL.Path, "status", ww.Status(), "duration_ms", time.Since(start).Milliseconds())
+		}()
+		next.ServeHTTP(ww, r.WithContext(ctx))
+	})
+}
+
+func (a *API) ready(w http.ResponseWriter, r *http.Request) {
+	ctx, cancel := context.WithTimeout(r.Context(), time.Second)
+	defer cancel()
+	if err := a.ping(ctx); err != nil {
+		a.failure(w, r, err)
+		return
+	}
+	respond(w, 200, map[string]string{"status": "ready"})
+}
+
+func (a *API) create(w http.ResponseWriter, r *http.Request) {
+	in, ok := decode(w, r)
+	if !ok {
+		return
+	}
+	p, err := a.repo.Create(r.Context(), in)
+	if err != nil {
+		a.failure(w, r, err)
+		return
+	}
+	w.Header().Set("Location", "/v1/products/"+p.ID.String())
+	respond(w, 201, p)
+}
+
+func (a *API) get(w http.ResponseWriter, r *http.Request) {
+	id, ok := productID(w, r)
+	if !ok {
+		return
+	}
+	p, err := a.repo.Get(r.Context(), id)
+	if err != nil {
+		a.failure(w, r, err)
+		return
+	}
+	respond(w, 200, p)
+}
+
+func (a *API) update(w http.ResponseWriter, r *http.Request) {
+	id, ok := productID(w, r)
+	if !ok {
+		return
+	}
+	in, ok := decode(w, r)
+	if !ok {
+		return
+	}
+	p, err := a.repo.Update(r.Context(), id, in)
+	if err != nil {
+		a.failure(w, r, err)
+		return
+	}
+	respond(w, 200, p)
+}
+
+func (a *API) delete(w http.ResponseWriter, r *http.Request) {
+	id, ok := productID(w, r)
+	if !ok {
+		return
+	}
+	if err := a.repo.Delete(r.Context(), id); err != nil {
+		a.failure(w, r, err)
+		return
+	}
+	w.WriteHeader(204)
+}
+
+func (a *API) list(w http.ResponseWriter, r *http.Request) {
+	q, err := catalog.ParseQuery(r.URL.RawQuery)
+	if err != nil {
+		fail(w, 400, "validation_error", err.Error())
+		return
+	}
+	products, err := a.repo.List(r.Context(), q)
+	if err != nil {
+		a.failure(w, r, err)
+		return
+	}
+	respond(w, 200, catalog.NewPage(products, q))
+}
+
+func productID(w http.ResponseWriter, r *http.Request) (uuid.UUID, bool) {
+	id, err := uuid.Parse(chi.URLParam(r, "id"))
+	if err != nil {
+		fail(w, 400, "validation_error", "id must be a UUID")
+		return uuid.Nil, false
+	}
+	return id, true
+}
+
+func decode(w http.ResponseWriter, r *http.Request) (catalog.Input, bool) {
+	var in catalog.Input
+	mediaType, _, err := mime.ParseMediaType(r.Header.Get("Content-Type"))
+	if err != nil || mediaType != "application/json" {
+		fail(w, 415, "unsupported_media_type", "Content-Type must be application/json")
+		return in, false
+	}
+	r.Body = http.MaxBytesReader(w, r.Body, 64<<10)
+	decoder := json.NewDecoder(r.Body)
+	decoder.DisallowUnknownFields()
+	if err = decoder.Decode(&in); err == nil {
+		// A second decode also drains trailing whitespace through the size limit.
+		var extra any
+		if err = decoder.Decode(&extra); errors.Is(err, io.EOF) {
+			err = in.Validate()
+		} else if err == nil {
+			err = errors.New("multiple JSON values")
+		}
+	}
+	if err != nil {
+		var tooLarge *http.MaxBytesError
+		if errors.As(err, &tooLarge) {
+			fail(w, 413, "payload_too_large", "body exceeds 64 KiB")
+		} else {
+			fail(w, 400, "validation_error", "invalid product JSON or field values")
+		}
+		return in, false
+	}
+	return in, true
+}
+
+func (a *API) failure(w http.ResponseWriter, r *http.Request, err error) {
+	switch {
+	case errors.Is(err, catalog.ErrNotFound):
+		fail(w, 404, "not_found", "product not found")
+	case errors.Is(err, catalog.ErrConflict):
+		fail(w, 409, "conflict", "SKU already exists")
+	default:
+		a.log.Error("repository failure", "request_id", middleware.GetReqID(r.Context()), "error", err)
+		fail(w, 503, "unavailable", "service temporarily unavailable")
+	}
+}
+
+func fail(w http.ResponseWriter, status int, code, message string) {
+	respond(w, status, map[string]any{"error": map[string]string{"code": code, "message": message}})
+}
+
+func respond(w http.ResponseWriter, status int, value any) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+	// All responses are JSON-safe DTOs. Transport write failures cannot be repaired
+	// after headers are sent; the client's context/connection controls their lifetime.
+	_ = json.NewEncoder(w).Encode(value)
+}
diff --git a/internal/httpapi/api_test.go b/internal/httpapi/api_test.go
